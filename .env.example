# DataLens Environment Variables
# Copy this file to .env and fill in your values

# LLM Provider — choose one: groq, openai, anthropic, gemini
LLM_PROVIDER=groq

# Groq API Key — get free key at https://console.groq.com
GROQ_API_KEY=

# OpenAI API Key — get at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API Key — get at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini API Key — get at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# SQLite database path (default: ./datalens.db)
DATABASE_URL=sqlite:///./datalens.db

# Max CSV upload size in bytes (default 50MB)
MAX_UPLOAD_BYTES=52428800
